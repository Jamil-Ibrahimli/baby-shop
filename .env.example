# # Шаблон переменных окружения. Скопируйте в .env и заполните реальными значениями.
# # .env НЕ коммитится (см. .gitignore). Реальные секреты в репозиторий не попадают.
# # Где всё это взять — пошагово в README, раздел «Деплой».

# # ── База данных (PostgreSQL / Supabase) ─────────────────────
# # Postgres и в разработке, и в продакшне — одна схема, одинаковое поведение.
# #
# # DATABASE_URL — ПУЛЕР (Supabase → Connect → Transaction pooler, порт 6543).
# #   Им пользуется приложение. На serverless без пулера база быстро упирается
# #   в лимит подключений.
# DATABASE_URL=""
# #
# # DIRECT_URL — SESSION POOLER (Supabase → Connect → Session pooler, порт 5432).
# #   Им пользуются только миграции (prisma migrate): в transaction-режиме нельзя
# #   держать advisory-лок и корректно применять DDL.
# #   ВАЖНО: не «Direct connection» (db.<ref>.supabase.co) — у новых проектов Supabase
# #   у этого хоста только IPv6, из сети без IPv6 миграции падают с P1001.
# #   Отличается от DATABASE_URL только портом: 6543 → 5432.
# DIRECT_URL=""

# # ── Хранилище фото товаров (Supabase Storage) ───────────────
# # Бакет должен быть ПУБЛИЧНЫМ (фото товаров отдаются всем посетителям).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# # service_role — секретный ключ, обходит RLS. Только на сервере, НИКОГДА в браузер.
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="product-images"

# # ── Аутентификация (Auth.js / NextAuth) ─────────────────────
# # Сгенерировать секрет: `npx auth secret`
# AUTH_SECRET=""
# # Локально — http://localhost:3000, на проде — адрес сайта (https://...)
# AUTH_URL="http://localhost:3000"

# # ── Telegram-уведомления владельцу ──────────────────────────
# # Токен бота от @BotFather и chat_id получателя уведомлений.
# # У каждого клиента — свой бот, поэтому значения только в .env.
# # Пусто → уведомления в Telegram молча не отправляются, остальное работает.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
