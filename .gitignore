# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Реальные env-файлы с секретами — НИКОГДА в репозиторий.
.env*
# Исключение: .env.example — публичный шаблон без значений, он нужен в репозитории.
!.env.example

# vercel
.vercel

# Локальные настройки Claude Code (личные, у каждого свои)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/lib/generated/prisma

# Остатки прежней локальной SQLite-базы (проект перешёл на Postgres/Supabase)
/prisma/*.db
/prisma/*.db-journal

# Остатки локальной загрузки фото (теперь фото уходят в Supabase Storage)
/public/uploads

# Бэкап миграций от SQLite-версии схемы — только для истории, применять нельзя
/.migrations-sqlite-backup
